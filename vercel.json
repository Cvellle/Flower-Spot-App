{
    "version": 2,
    "builds": [
        {
            "src": "vite.config.ts",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/dist/$1"
        }
    ],
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "https://a101116f092d1803361fee7a7e86c79f0665e82a.flowrspot.povio-projects.online:path*"
        }
    ]
}